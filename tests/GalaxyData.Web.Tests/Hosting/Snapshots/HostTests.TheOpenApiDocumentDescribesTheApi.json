    "/api/users/{id}/unlock": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Lets a user locked out by failed sign-ins sign in again",
        "operationId": "UnlockUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
